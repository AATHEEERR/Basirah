# What `gcloud run deploy --source .` leaves out of the upload. The keys
# never leave this machine: server/.env is listed here and in .gitignore.
#!include:.gitignore
.git
.gitignore
.gcloudignore
server/.env
server/cache
server/data
build
.dart_tool
server/.dart_tool
packages/basirah_core/.dart_tool
.idea
*.docx
*.pdf
