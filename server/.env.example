# Copy this file to `.env` (same folder) and fill in ONE key.
# `.env` is gitignored — never commit a real key, never paste it in a chat.

# ── Option A: Google Gemini (has a free tier) ─────────────────────────────
# Get a key: https://aistudio.google.com/apikey
# Free tier: Google may use free-tier content to improve its products.
GEMINI_API_KEY=
# Optional: model id (default gemini-2.5-flash) and thinking level
# (minimal | low | medium | high) for models that support it.
GEMINI_MODEL=
GEMINI_THINKING=

# ── Option B: Anthropic Claude (paid API credits) ─────────────────────────
# Get a key: https://platform.claude.com  →  API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=high
CLAUDE_FALLBACKS=default

# If both keys are set, choose one: gemini | claude (default: gemini)
AI_PROVIDER=

# Server
ALLOWED_ORIGIN=*
PORT=8080
